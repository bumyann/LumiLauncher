{
  "name": "lumilauncher",
  "version": "1.0.2",
  "description": "A launcher for Lumiverse with human-readable error handling",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.bumyann.lumilauncher",
    "productName": "LumiLauncher",
    "win": {
  "target": "nsis",
  "icon": "assets/icon.ico"
},
"mac": {
  "icon": "assets/icon.icns"
},
"linux": {
  "target": "AppImage",
  "icon": "assets/icon.png"
},
"icon": "assets/icon.ico",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
  "provider": "github",
  "owner": "bumyann",
  "repo": "LumiLauncher",
  "releaseType": "release"
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ]
  },
  "keywords": ["lumiverse", "launcher"],
  "author": "bumyann",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  }
}
